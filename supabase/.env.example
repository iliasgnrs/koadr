# Supabase on the VPS — copy to /opt/supabase/.env, then `chmod 600`.
#
# Generate every secret locally; never paste one into a shell history that is
# recorded, and never commit the filled-in file.
#
#   POSTGRES_PASSWORD      openssl rand -base64 32
#   JWT_SECRET             openssl rand -base64 48
#   ANON_KEY / SERVICE_ROLE_KEY
#                          HS256 JWTs signed with JWT_SECRET, payload
#                          {"role":"anon"|"service_role","iss":"supabase",
#                           "iat":<now>,"exp":<now + 10y>}
#
# The anon key is public (it ships to the browser); the service-role key must
# never reach a `VITE_` variable or the client bundle.

POSTGRES_PASSWORD=CHANGE_ME

# Public origin of the app. GoTrue builds verification links from SITE_URL and
# only honours redirects that match ADDITIONAL_REDIRECT_URLS.
SITE_URL=https://app.koadr.dev
ADDITIONAL_REDIRECT_URLS=https://app.koadr.dev/**

# Where GoTrue is reachable by the app. Internal only — no host port is
# published, so this stays a container-network address.
API_EXTERNAL_URL=http://auth:9999

JWT_SECRET=CHANGE_ME
JWT_EXPIRY=3600
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME

# Resend SMTP (GoTrue sends verification / magic link / recovery mail).
# Host is smtp.resend.com, user is the literal string "resend", pass is the API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=CHANGE_ME
SMTP_ADMIN_EMAIL=no-reply@koadr.dev
SMTP_SENDER_NAME=Koadr
