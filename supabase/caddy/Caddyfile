# Fronts both Supabase APIs under one origin, mirroring what Supabase's own
# API gateway (Kong/Envoy) does. supabase-js derives both paths from the single
# SUPABASE_URL, so one origin must serve /auth/v1/* and /rest/v1/*.
#
#   /auth/v1/* -> GoTrue      (prefix stripped; GoTrue serves /signup, /health, ...)
#   /rest/v1/* -> PostgREST   (prefix stripped; PostgREST serves /<table>)
#
# This replaces ~1 GB of gateway with a 5 MB container.
:9999 {
	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy auth:9999
	}

	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy rest:3000
	}

	# Bare paths are already Supabase-native (/health, /signup, /token, ...).
	handle {
		reverse_proxy auth:9999
	}
}
